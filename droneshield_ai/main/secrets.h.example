#define DSHL_WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

/* HiveMQ Cloud (TLS, port 8883) */
#define DSHL_MQTT_HOST      "xxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud"
#define DSHL_MQTT_PORT      8883
#define DSHL_MQTT_USERNAME  "droneshield_device_01"
#define DSHL_MQTT_PASSWORD  "YOUR_HIVEMQ_PASSWORD"
