# DroneShield AI - ESP32-S2 defaults (ESP-IDF 5.5.x)
CONFIG_IDF_TARGET="esp32s2"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Wi-Fi / LWIP
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# MQTT over TLS
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n

# TLS / certificates: use the standard ESP-IDF certificate bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# Console / UART0 stays the debug console; simulator link uses UART1
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Reduce flash footprint a little
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Task watchdog: allow longer offline reconnect windows
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
